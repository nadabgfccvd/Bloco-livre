<?xml version="1.0" encoding="utf-8"?>
<!--
  Bloco Livre — manifest mínimo.
  NENHUMA permissão pedida: nem INTERNET, nem armazenamento, nem vibração
  (a vibração só funciona se o aparelho já permitir; sem a permissão
  VIBRATE ela é silenciosamente ignorada — mantemos o manifest limpo).
  Sem rede = sem anúncios = sem rastreamento, por construção.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.blocolivre"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:allowBackup="true"
        android:hardwareAccelerated="true">

        <activity android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- vitrine de arte para crítica/preview (não aparece no launcher) -->
        <activity android:name=".DemoActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <!-- alvos determinísticos de fotografia (herdam DemoActivity) -->
        <activity android:name=".ShotSceneClear"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"/>
        <activity android:name=".ShotSceneFull"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"/>
        <activity android:name=".ShotSkin0"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"/>
        <activity android:name=".ShotSkin1"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"/>
        <activity android:name=".ShotSkin2"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"/>
        <activity android:name=".ShotSkin3"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"/>
        <activity android:name=".ShotHero" 

            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"/>
    </application>
</manifest>
